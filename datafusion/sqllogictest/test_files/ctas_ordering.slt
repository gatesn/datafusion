# CTAS retains the executed ordering, including aliases, direction and null placement.
statement ok
SET datafusion.explain.physical_plan_only = true

statement ok
CREATE TABLE ordered_ctas AS
SELECT a AS "key.with.dot", b AS value
FROM (VALUES (1, 2), (NULL, 1), (1, NULL), (2, 0)) AS t(a, b)
ORDER BY 1 DESC NULLS LAST, 2 ASC NULLS FIRST

query TT
EXPLAIN SELECT * FROM ordered_ctas
ORDER BY "key.with.dot" DESC NULLS LAST, value ASC NULLS FIRST
----
physical_plan DataSourceExec: partitions=1, partition_sizes=[1], output_ordering=key.with.dot@0 DESC NULLS LAST, value@1 ASC

query II
SELECT * FROM ordered_ctas ORDER BY "key.with.dot" DESC NULLS LAST, value ASC NULLS FIRST
----
2 0
1 NULL
1 2
NULL 1

# Ordering inherited from a provider also survives CTAS without an ORDER BY clause.
statement ok
CREATE TABLE inherited_ctas AS SELECT * FROM ordered_ctas

query TT
EXPLAIN SELECT * FROM inherited_ctas
ORDER BY "key.with.dot" DESC NULLS LAST, value ASC NULLS FIRST
----
physical_plan DataSourceExec: partitions=1, partition_sizes=[1], output_ordering=key.with.dot@0 DESC NULLS LAST, value@1 ASC

# Replacing a table must publish the replacement's ordering.
statement ok
CREATE OR REPLACE TABLE ordered_ctas AS
SELECT * FROM inherited_ctas
ORDER BY "key.with.dot" ASC NULLS FIRST, value DESC NULLS LAST

query TT
EXPLAIN SELECT * FROM ordered_ctas
ORDER BY "key.with.dot" ASC NULLS FIRST, value DESC NULLS LAST
----
physical_plan DataSourceExec: partitions=1, partition_sizes=[1], output_ordering=key.with.dot@0 ASC, value@1 DESC NULLS LAST

# An unrepresentable key ends the usable prefix; later keys cannot be skipped.
statement ok
CREATE TABLE prefix_ctas AS
SELECT a, b, c FROM (VALUES (1, -3, 0), (1, 2, 9), (2, 1, 0)) AS t(a, b, c)
ORDER BY a, abs(b), c

query TT
EXPLAIN SELECT * FROM prefix_ctas ORDER BY a, c
----
physical_plan
01)SortExec: expr=[a@0 ASC NULLS LAST, c@2 ASC NULLS LAST], preserve_partitioning=[false]
02)--DataSourceExec: partitions=1, partition_sizes=[1], output_ordering=a@0 ASC NULLS LAST

statement ok
SET datafusion.explain.physical_plan_only = false
